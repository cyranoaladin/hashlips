############################################
# Chemins locaux / projet
############################################

# Racine du projet sur ta machine.
PROJECT_ROOT=/chemin/vers/ton/projet/hashlips

# (Optionnel) Chemin d’un autre fichier .env à sourcer avant celui-ci.
# Laisse vide si tu n’en utilises pas.
ENV_PATH=

# Chemins vers les configs Sugar (utilisés par scripts CLI).
CONFIG_JSON_PATH=${PROJECT_ROOT}/config.json
GUARD_CONFIG_JSON_PATH=${PROJECT_ROOT}/guard.config.json
CONFIG_LOCAL_JSON_PATH=${PROJECT_ROOT}/config.local.json

############################################
# Solana + scripts Umi (mint côté SDK)
############################################

# URL RPC. Devnet par défaut. Pour mainnet : https://api.mainnet-beta.solana.com
RPC_URL=https://api.devnet.solana.com

# Keypair Solana (JSON). Par défaut : ~/.config/solana/id.json
# Mets le chemin de TON wallet (ex: ${HOME}/.config/solana/id.json ou ${HOME}/mfai-wallet.json)
KEYPAIR_PATH=${HOME}/.config/solana/id.json

# Fichier cache Sugar (généré après upload/deploy)
CACHE_PATH=${PROJECT_ROOT}/cache.json

# Reprise pour compatibilité (même que ci-dessus)
GUARD_CONFIG_PATH=${PROJECT_ROOT}/guard.config.json

# Label du groupe de guards (par défaut "default" si tu n’utilises pas de groupes nommés)
GUARD_LABEL=default

# **IMPORTANT**: Update authority attendu par la Candy Machine au moment du mint.
# Pour CM V3 + Guard, c’est le PDA "candyMachineCreator" (à lire dans cache.json).
# Ex: jq -r '.program.candyMachineCreator' ${CACHE_PATH}
COLLECTION_UPDATE_AUTHORITY=

# Unités de calcul max pour la tx (Compute Units). 400000 convient en général.
COMPUTE_UNITS=400000

# Pour les frais de priorité (en micro-lamports). 0 = pas de priorité.
PRIORITY_MICROLAMPORTS=0

############################################
# Métadonnées collection / paramètres CM
############################################

# Préfixe du nom (Sugar V3: "config line settings"). Exemple: "My NFT"
COLLECTION_NAME_PREFIX=Nom de votre NFT

# Description générique de la collection
COLLECTION_DESCRIPTION=Description de votre collection

# Base URI des métadonnées (si tu utilises un schéma de type base + index).
# Avec Pinata/gateway: https://gateway.pinata.cloud/ipfs/<CID>/
# Avec "ipfs://" direct: ipfs://<CID>/
COLLECTION_BASE_URI=ipfs://NewUriToReplace

# Nombre d’items de la CM.
COLLECTION_SIZE=10

# Symbole (max 10 chars recommandé).
COLLECTION_SYMBOL=OINCO

# Lien externe (site ou page du projet).
COLLECTION_EXTERNAL_URL=https://www.votre-site.com

# Royalties en basis points (10000 = 100%). 1000 = 10%.
COLLECTION_SELLER_FEE_BPS=1000

# Réseau. Conserve "sol".
COLLECTION_NETWORK=sol

# Créateur principal (pubkey) et part. Somme des shares doit faire 100.
CREATOR_ADDRESS=5zHBXzhaqKXJRMd7KkuWsb4s8zPyakKdijr9E3jgyG8Z
CREATOR_SHARE=100

# (Optionnel) JSON des creators multiples (si tu veux overrides complexes).
# Laisser vide si tu utilises CREATOR_ADDRESS/SHARE ci-dessus.
# Format attendu par tes scripts (ex: [{"address":"...","share":70},{"address":"...","share":30}])
COLLECTION_CREATORS_JSON=

# Standard: "nft" (NFT standard). (pNFT = programmable NFT demande ruleSet et flux différent)
TOKEN_STANDARD=nft

# NFT mutable ? (true/false)
IS_MUTABLE=true

# Mint séquentiel ? (false recommandé)
IS_SEQUENTIAL=false

# Méthode d’upload: "pinata" | "aws" | "nft-storage" | "shdw" | "sdrive"
UPLOAD_METHOD=pinata

# RuleSet pour pNFT (souvent null si tu restes en "nft")
RULE_SET=null

# Max edition supply (souvent null si non utilisé)
MAX_EDITION_SUPPLY=null

# Hidden settings (pour blind mints), null si non utilisés
HIDDEN_SETTINGS=null

# AWS_CONFIG pour upload S3 (null si non utilisé)
AWS_CONFIG=null

# Clé pour SDrive (null si non utilisé)
SDRIVE_API_KEY=

# Token pour nft.storage (null si non utilisé)
NFT_STORAGE_AUTH_TOKEN=

# Compte Shadow Drive (null si non utilisé)
SHDW_STORAGE_ACCOUNT=

############################################
# Pinata (si UPLOAD_METHOD=pinata)
############################################

# **SECRET**: JWT Pinata (clé "scoped key" / "API key JWT"). NE JAMAIS COMMIT.
PINATA_JWT=

# Endpoints Pinata (upload et gateway de contenu)
PINATA_API_GATEWAY=https://api.pinata.cloud
PINATA_CONTENT_GATEWAY=https://gateway.pinata.cloud

# Concurrence upload. 50-200 raisonnable selon ta connexion.
PINATA_PARALLEL_LIMIT=100

############################################
# Guards (Candy Guard "default")
############################################

# Prix en SOL (0.01 = 0.01 SOL). Le guard solPayment attend cette valeur en SOL
SOL_PAYMENT_VALUE=0.01

# Destination des SOL payés au mint (pubkey).
SOL_PAYMENT_DESTINATION=5zHBXzhaqKXJRMd7KkuWsb4s8zPyakKdijr9E3jgyG8Z

############################################
# Overrides locaux (dev/test uniquement)
############################################

# Exemple: forcer mutable en local sans toucher la prod
LOCAL_IS_MUTABLE=false

# Changer le prix en local (ex: 1 SOL)
LOCAL_SOL_PAYMENT_VALUE=1

# Destinataire local (tests)
LOCAL_SOL_PAYMENT_DESTINATION=5zHBXzhaqKXJRMd7KkuWsb4s8zPyakKdijr9E3jgyG8Z

# Overrides divers (laisse vide pour hériter des valeurs principales)
LOCAL_UPLOAD_METHOD=
LOCAL_RULE_SET=
LOCAL_MAX_EDITION_SUPPLY=
LOCAL_PINATA_JWT=
LOCAL_PINATA_API_GATEWAY=
LOCAL_PINATA_CONTENT_GATEWAY=
LOCAL_PINATA_PARALLEL_LIMIT=
