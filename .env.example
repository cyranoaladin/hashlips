### Runtime paths
PROJECT_ROOT=/absolute/path/to/hashlips
ENV_PATH=
CONFIG_JSON_PATH=/absolute/path/to/hashlips/config.json
GUARD_CONFIG_JSON_PATH=/absolute/path/to/hashlips/guard.config.json
CONFIG_LOCAL_JSON_PATH=/absolute/path/to/hashlips/config.local.json

### Solana + Umi scripts
RPC_URL=https://api.devnet.solana.com
KEYPAIR_PATH=/absolute/path/to/wallet.json
CACHE_PATH=/absolute/path/to/hashlips/cache.json
GUARD_CONFIG_PATH=/absolute/path/to/hashlips/guard.config.json
GUARD_LABEL=default
COLLECTION_UPDATE_AUTHORITY=
COMPUTE_UNITS=400000
PRIORITY_MICROLAMPORTS=0

### Candy Machine & collection metadata
COLLECTION_NAME_PREFIX=Nom de votre NFT
COLLECTION_DESCRIPTION=Description de votre collection
