# Configuration pour le déploiement des NFTs Oinkonomics sur Solana

# ═══════════════════════════════════════════════════════════
# CONFIGURATION RÉSEAU SOLANA
# ═══════════════════════════════════════════════════════════

# URL du réseau Solana (mainnet-beta pour production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Ou utiliser un RPC privé pour de meilleures performances:
# SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# SOLANA_RPC_URL=https://rpc.helius.xyz/?api-key=YOUR_API_KEY

# ═══════════════════════════════════════════════════════════
# CONFIGURATION WALLET
# ═══════════════════════════════════════════════════════════

# Chemin vers votre keypair Solana (wallet)
WALLET_PATH=/root/.config/solana/id.json

# Adresse publique du wallet (Treasury)
TREASURY_ADDRESS=5zHBXzhaqKXJRMd7KkuWsb4s8zPyakKdijr9E3jgyG8Z

# ⚠️  IMPORTANT: 
# - Ne JAMAIS commiter votre keypair dans Git!
# - Gardez une sauvegarde sécurisée de votre keypair
# - Utilisez un wallet dédié pour les déploiements avec le montant exact nécessaire

# ═══════════════════════════════════════════════════════════
# CONFIGURATION COLLECTION NFT
# ═══════════════════════════════════════════════════════════

# Nombre total de NFTs
NFT_COUNT=300

# Symbole de la collection
COLLECTION_SYMBOL=OINK

# Prix de mint (en SOL)
MINT_PRICE=0.1

# Royalties (en points de base, 500 = 5%)
ROYALTIES_BASIS_POINTS=500

# Date de lancement (format ISO 8601)
GO_LIVE_DATE=2025-01-15T00:00:00Z

# URL externe de la collection
EXTERNAL_URL=https://oinkonomics.mfai.app

# ═══════════════════════════════════════════════════════════
# CONFIGURATION SUGAR
# ═══════════════════════════════════════════════════════════

# Méthode d'upload (bundlr pour Arweave, nft_storage, aws, etc.)
UPLOAD_METHOD=bundlr

# Garder l'autorité après le déploiement (true/false)
RETAIN_AUTHORITY=true

# Collection mutable (peut être modifiée après mint)
IS_MUTABLE=true

# ═══════════════════════════════════════════════════════════
# CONFIGURATION SERVEUR
# ═══════════════════════════════════════════════════════════

# Hôte du serveur de déploiement
SERVER_HOST=mf

# Répertoire distant sur le serveur
REMOTE_DIR=/root/hashlips

# ═══════════════════════════════════════════════════════════
# ESTIMATION DES COÛTS (pour information)
# ═══════════════════════════════════════════════════════════

# Coûts estimés pour 300 NFTs sur mainnet:
# - Upload vers Arweave (via Bundlr): ~0.3-0.5 SOL
# - Création Candy Machine: ~0.01 SOL
# - Frais de transaction: ~0.001 SOL par NFT
# - Buffer de sécurité: ~0.1 SOL
# 
# TOTAL RECOMMANDÉ: 1 SOL minimum dans le wallet

# ═══════════════════════════════════════════════════════════
# NOTES DE SÉCURITÉ
# ═══════════════════════════════════════════════════════════

# 1. Toujours tester sur devnet avant mainnet
# 2. Vérifier le solde avant chaque opération
# 3. Faire des backups réguliers des assets et métadonnées
# 4. Utiliser un wallet dédié pour les déploiements
# 5. Supprimer les keypairs du serveur après déploiement
# 6. Documenter l'adresse de la Candy Machine créée
