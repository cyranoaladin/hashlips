############################################
# Local paths / project layout
############################################

# Absolute path to the project root on your workstation.
PROJECT_ROOT=/path/to/your/hashlips/project

# Optional: another .env file to source before this one. Leave empty if unused.
ENV_PATH=

# Locations of the generated Sugar configs (consumed by CLI scripts).
# For multi-tier deployments, point these to config.poor.json, config.mid.json, etc.
CONFIG_JSON_PATH=${PROJECT_ROOT}/config.json
GUARD_CONFIG_JSON_PATH=${PROJECT_ROOT}/guard.config.json
CONFIG_LOCAL_JSON_PATH=${PROJECT_ROOT}/config.local.json

############################################
# Solana configuration & Umi scripts
############################################

# RPC endpoint. Devnet by default. For mainnet use https://api.mainnet-beta.solana.com
RPC_URL=https://api.devnet.solana.com

# Solana keypair JSON. Defaults to ~/.config/solana/id.json
# Point this to YOUR wallet (e.g. ${HOME}/.config/solana/id.json or ${HOME}/custom-wallet.json)
KEYPAIR_PATH=${HOME}/.config/solana/id.json

# Sugar cache file generated after upload/deploy. Duplicate this per tier
# (e.g. cache.poor.json, cache.mid.json) and adjust for each .env.<tier> blueprint.
CACHE_PATH=${PROJECT_ROOT}/cache.json

# Backwards compatibility alias (same as above).
GUARD_CONFIG_PATH=${PROJECT_ROOT}/guard.config.json

# Guard group label. Keep "default" unless you created named guard groups.
GUARD_LABEL=default

# IMPORTANT: expected collection update authority during mint.
# For CM v3 + Guard this is the PDA "candyMachineCreator" (see cache.json).
# Example: jq -r '.program.candyMachineCreator' ${CACHE_PATH}
COLLECTION_UPDATE_AUTHORITY=

# Optional explicit collection mint. When left blank, scripts pull the value from cache.json.
COLLECTION_MINT=

# Compute units to request for the transaction. 400000 works well on Devnet.
COMPUTE_UNITS=400000

# Priority fee in micro-lamports. 0 disables priority fees.
PRIORITY_MICROLAMPORTS=0

# Optional key used when the thirdPartySigner guard is active. Provide both the
# signer keypair path (server-side) and the public key stored in guard configs.
THIRD_PARTY_SIGNER_KEYPAIR_PATH=
THIRD_PARTY_SIGNER_PUBKEY=

############################################
# Collection metadata / Candy Machine settings
############################################

# Name prefix (Sugar v3 "config line settings"). Example: "My NFT"
COLLECTION_NAME_PREFIX=Name of your NFT

# Generic collection description
COLLECTION_DESCRIPTION=Project tagline and value proposition

# Base URI for metadata (if you use base + index scheme).
# With Pinata/gateway: https://gateway.pinata.cloud/ipfs/<CID>/
# Using ipfs:// directly: ipfs://<CID>/
COLLECTION_BASE_URI=ipfs://NewUriToReplace

# Number of items in the collection.
COLLECTION_SIZE=10

# Short symbol (ideally ≤ 10 chars).
COLLECTION_SYMBOL=OINCO

# External link (landing page or project website).
COLLECTION_EXTERNAL_URL=https://www.your-site.com

# Royalties in basis points (10000 = 100%). 1000 = 10%.
COLLECTION_SELLER_FEE_BPS=1000

# Network identifier. Keep "sol".
COLLECTION_NETWORK=sol

# Primary creator public key + share. Total share across creators must equal 100.
CREATOR_ADDRESS=5zHBXzhaqKXJRMd7KkuWsb4s8zPyakKdijr9E3jgyG8Z
CREATOR_SHARE=100

# Optional: JSON payload describing multiple creators if needed.
# Leave empty when using CREATOR_ADDRESS/CREATOR_SHARE above.
# Example: [{"address":"PUBKEY1","share":70},{"address":"PUBKEY2","share":30}]
COLLECTION_CREATORS_JSON=

# Token standard. "pnft" enables programmable NFTs required for rule sets.
TOKEN_STANDARD=pnft

# Should the NFT remain mutable? (true/false)
IS_MUTABLE=true

# Sequential minting order? (false recommended)
IS_SEQUENTIAL=false

# Upload backend: "pinata" | "aws" | "nft-storage" | "shdw" | "sdrive"
UPLOAD_METHOD=pinata

# Rule set for pNFTs. Supply the "no-transfer" ruleset address when using programmable NFTs.
RULE_SET=REPLACE_WITH_RULE_SET_ADDRESS

# Max edition supply. Leave null when unused.
MAX_EDITION_SUPPLY=null

# Hidden settings for blind minting. Leave null when unused.
HIDDEN_SETTINGS=null

# AWS configuration (JSON or profile name) if using AWS uploads. Null otherwise.
AWS_CONFIG=null

# Sdrive API key (if using sdrive uploads).
SDRIVE_API_KEY=

# NFT.storage auth token (if using nft-storage uploads).
NFT_STORAGE_AUTH_TOKEN=

# Shadow Drive account (if using shdw uploads).
SHDW_STORAGE_ACCOUNT=

############################################
# Pinata configuration (when UPLOAD_METHOD=pinata)
############################################

# SECRET: Pinata JWT (scoped key / API key JWT). NEVER COMMIT THIS VALUE.
PINATA_JWT=

# Pinata upload and content gateways.
PINATA_API_GATEWAY=https://api.pinata.cloud
PINATA_CONTENT_GATEWAY=https://gateway.pinata.cloud

# Parallel upload limit. 50-200 is a good range depending on bandwidth.
PINATA_PARALLEL_LIMIT=100

############################################
# Candy Guard (default group)
############################################

# Price in SOL (use a numeric value) or "null" for free mints.
SOL_PAYMENT_VALUE=null

# Destination for SOL payments collected at mint time (ignored when SOL_PAYMENT_VALUE=null).
SOL_PAYMENT_DESTINATION=

# thirdPartySigner guard (optional, used to co-sign mints server-side for tiered access)
# Provide the signer public key above and store the signer keypair securely off-chain.

############################################
# Local overrides (development / testing only)
############################################

# Example: force mutability locally without impacting production configuration.
LOCAL_IS_MUTABLE=false

# Change the local guard price (e.g. 1 SOL for playground mints).
LOCAL_SOL_PAYMENT_VALUE=null

# Local destination for SOL collected during test mints.
LOCAL_SOL_PAYMENT_DESTINATION=

# Additional overrides (leave blank to inherit from the primary values).
LOCAL_UPLOAD_METHOD=
LOCAL_RULE_SET=
LOCAL_MAX_EDITION_SUPPLY=
LOCAL_PINATA_JWT=
LOCAL_PINATA_API_GATEWAY=
LOCAL_PINATA_CONTENT_GATEWAY=
LOCAL_PINATA_PARALLEL_LIMIT=
LOCAL_THIRD_PARTY_SIGNER_PUBKEY=
# When using a local guard override, point to an alternate third-party signer public key.
LOCAL_THIRD_PARTY_SIGNER_PUBKEY=
